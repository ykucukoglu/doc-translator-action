---
import BaseLayout from '../layouts/BaseLayout.astro';
import CacheInspector from '../components/CacheInspector.astro';
import WorkflowGenerator from '../components/WorkflowGenerator.astro';
import { withBase } from '../utils/url';

const features = [
  { title: 'AST-based parsing', body: 'Markdig, not regex. Code fences, inline code, and link/image URLs are structurally impossible to mistranslate.' },
  { title: 'Zero-cost content-hash cache', body: "Each paragraph's translation is cached by a hash of its own content, not git line numbers, so unrelated edits elsewhere in a file never trigger a re-translation." },
  { title: 'Self-healing reconstruction', body: 'A translation that drops a required marker is repaired (up to 2 retries) before falling back to leaving just that paragraph untranslated.' },
  { title: 'Job Summary', body: "A Markdown execution report - chunk/cache counts, token usage, warnings - on every run's GitHub Actions Summary tab." },
  { title: 'Four LLM providers', body: "Gemini, OpenAI, Claude, and Azure OpenAI, all behind Microsoft.Extensions.AI's IChatClient, via each vendor's official SDK." },
  { title: 'Resilient & concurrent', body: 'Polly v8 exponential backoff on transient HTTP failures; batch requests run concurrently, bounded by max-parallel-requests.' },
  { title: 'Drift detection', body: 'Flags translated files whose source has changed since they were last translated.' },
  { title: '.doc-ignore', body: 'Exclude files like CHANGELOG.md or DRAFT_*.md from the pipeline entirely.' },
  { title: 'Frontmatter & admonitions aware', body: 'YAML/TOML frontmatter and Docusaurus/MyST admonition blocks are recognized structurally, not swept into translatable text.' },
  { title: 'Mermaid diagram labels', body: 'Opt-in: translates node/edge/subgraph text inside flowchart/graph diagrams; arrows, node ids, and syntax are never touched.' },
  { title: 'ChatOps-friendly', body: 'push-to-current-branch commits straight onto whatever branch is checked out instead of opening a new PR.' },
  { title: 'Rich PR summary comment', body: 'A side-by-side original/translated preview per file, a count of code blocks/links/glossary terms preserved untouched, and a mention of whoever triggered the run.' },
];

const beforeMd = `This paragraph has **bold text**, *italic text*, and ***bold italic text*** mixed with \`inline code\`.

You can also nest **bold with *italic inside* it** for emphasis, and a **bold [link](https://example.com/bold-link) inside bold**.`;

const afterMd = `Bu paragrafta **kalın metin**, *italik metin* ve \`inline code\` ile karışık ***kalın italik metin*** bulunur.

Ayrıca vurgu için **içinde *italik* olan kalın metni** iç içe kullanabilir ve **kalın [bağlantı](https://example.com/bold-link) içeren kalın metni** de kullanabilirsiniz.`;
---

<BaseLayout
  title="doc-translator-action"
  description="A GitHub Action that translates Markdown documentation via a real AST, without breaking code snippets, links, or frontmatter."
>
  <section class="hero container">
    <div>
      <p class="eyebrow">GitHub Action · .NET 9</p>
      <h1>Every code fence survives the trip.</h1>
      <p class="hero__sub">
        Markdown is parsed into a real AST — only the natural-language text is ever sent to an LLM. Code, diagrams,
        and links are never touched.
      </p>
      <div class="hero__actions">
        <a href={withBase('/getting-started')} class="button button--primary">Get started</a>
        <a href="https://github.com/ykucukoglu/doc-translator-action" target="_blank" rel="noreferrer" class="button">
          View source ↗
        </a>
      </div>
    </div>

    <div class="hero__side">
      <div class="terminal">
        <div class="terminal__bar">doc-translator-action</div>
        <div class="terminal__body">
          <p class="terminal__line"><span class="terminal__prompt">$</span> doc-translator-action \</p>
          <p class="terminal__line">&nbsp;&nbsp;&nbsp;&nbsp;--target-languages tr,de</p>
          <p class="terminal__line"><span class="terminal__ok">✓</span> 3 chunks translated · 9 from cache</p>
          <p class="terminal__line"><span class="terminal__signal">✓</span> 2 code blocks, 1 diagram left untouched</p>
          <p class="terminal__line">
            <span class="terminal__arrow">→</span> Pull request opened<span class="terminal__cursor" aria-hidden="true"></span>
          </p>
        </div>
      </div>

      <div class="badges">
        <div class="badge"><b>AST Protected</b><span>Markdig, not regex</span></div>
        <div class="badge"><b>Zero-Cost Cache</b><span>Content-hash, per chunk</span></div>
        <div class="badge"><b>Multi-LLM</b><span>Gemini · OpenAI · Claude</span></div>
      </div>
    </div>
  </section>

  <section class="container diff-demo" aria-labelledby="diff-demo-heading">
    <p class="eyebrow" id="diff-demo-heading">Real fixture, not a mockup</p>
    <p class="diff-demo__caption">
      From this repo's own test suite (<code>mixed-inline-formatting.md</code>) — bold, italic, inline code, and a link
      all survive translation exactly where they started.
    </p>
    <div class="diff-demo__panels">
      <div class="diff-demo__panel">
        <p class="diff-demo__label">Source (English)</p>
        <pre>{beforeMd}</pre>
      </div>
      <div class="diff-demo__panel">
        <p class="diff-demo__label">Translated (Turkish)</p>
        <pre>{afterMd}</pre>
      </div>
    </div>
  </section>

  <section class="container features" aria-labelledby="features-heading">
    <p class="eyebrow" id="features-heading">Core features</p>
    <dl class="features__list">
      {
        features.map((f, i) => (
          <div class="features__item">
            <dt>
              <span class="features__index tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              {f.title}
            </dt>
            <dd>{f.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container" aria-labelledby="cache-heading">
    <p class="eyebrow" id="cache-heading">Try it — cost</p>
    <CacheInspector />
  </section>

  <section class="container" aria-labelledby="workflow-heading">
    <p class="eyebrow" id="workflow-heading">Try it — workflow</p>
    <WorkflowGenerator />
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-16);
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      gap: var(--space-16);
      padding-block: var(--space-24) var(--space-16);
    }
  }

  .hero h1 {
    margin-top: var(--space-4);
    font-size: 3.5rem;
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .hero h1 {
      font-size: 4rem;
    }
  }

  .hero__sub {
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
    color: var(--color-ink-muted);
    max-width: 30rem;
    line-height: 1.65;
  }

  .hero__actions {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-4);
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .terminal {
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
  }

  .terminal__bar {
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--border-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .terminal__body {
    background: var(--color-bg);
    padding: var(--space-4) var(--space-4) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 2;
    overflow-x: auto;
  }

  .terminal__line {
    margin: 0;
    white-space: pre;
  }

  .terminal__prompt {
    color: var(--color-ink-muted);
  }

  .terminal__ok {
    color: var(--color-accent);
  }

  .terminal__signal {
    color: var(--color-signal);
  }

  .terminal__arrow {
    color: var(--color-ink);
  }

  .terminal__cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: var(--color-accent);
    vertical-align: text-bottom;
    margin-left: 0.15em;
    animation: terminal-blink 1.1s steps(1) infinite;
  }

  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal__cursor {
      animation: none;
    }
  }

  .badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .badge {
    padding: var(--space-3) var(--space-2);
    text-align: center;
    border-right: var(--border-hairline);
    background: var(--color-bg-raised);
  }

  .badge:last-child {
    border-right: none;
  }

  .badge b {
    display: block;
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .badge span {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-muted);
    line-height: 1.4;
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-ink);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .button:hover {
    background: var(--color-bg-raised);
  }

  .button--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .button--primary:hover {
    opacity: 0.9;
    background: var(--color-accent);
  }

  .diff-demo {
    padding-block: var(--space-16);
    border-top: var(--border-hairline);
  }

  .diff-demo__caption {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    max-width: 40rem;
  }

  .diff-demo__panels {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 56rem) {
    .diff-demo__panels {
      grid-template-columns: 1fr 1fr;
    }
  }

  .diff-demo__panel {
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .diff-demo__label {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-raised);
    border-bottom: var(--border-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  .diff-demo__panel pre {
    margin: 0;
    padding: var(--space-4);
    font-size: var(--text-code);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .features {
    padding-block: var(--space-16);
    border-top: var(--border-hairline);
  }

  .features__list {
    margin: var(--space-6) 0 0;
    display: grid;
    gap: 0;
    border-top: var(--border-hairline);
  }

  @media (min-width: 56rem) {
    .features__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .features__item {
    padding: var(--space-6) var(--space-4) var(--space-6) 0;
    border-bottom: var(--border-hairline);
  }

  @media (min-width: 56rem) {
    .features__item:nth-child(odd) {
      padding-right: var(--space-8);
      border-right: var(--border-hairline);
    }
    .features__item:nth-child(even) {
      padding-left: var(--space-8);
    }
  }

  .features__item dt {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-weight: 600;
    font-size: var(--text-h4);
  }

  .features__index {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-accent);
  }

  .features__item dd {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-muted);
  }

  section + section.container {
    margin-top: 0;
  }
</style>
