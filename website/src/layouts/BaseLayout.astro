---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Astro.url.pathname already carries the /doc-translator-action base when deployed (Astro
// resolves it internally from astro.config.mjs's `base`), so resolving it against `site` here
// - rather than reaching for withBase() again - is what gives the correct, un-doubled absolute
// URL. OG/Twitter cards require an absolute image URL; a relative one silently fails to preview
// on every platform that consumes this markup.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(withBase('og-image.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'doc-translator-action' ? title : `${title} · doc-translator-action`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="doc-translator-action" />
    <meta property="og:title" content={title === 'doc-translator-action' ? title : `${title} · doc-translator-action`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title === 'doc-translator-action' ? title : `${title} · doc-translator-action`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      // Runs before first paint to avoid a flash of the wrong theme. Kept intentionally tiny
      // and dependency-free since it blocks rendering. Dark is the deliberate brand default
      // (not derived from OS preference) - only an explicit toggle choice, persisted here,
      // overrides it. Bare :root in tokens.css already carries the dark values, so this also
      // degrades correctly with JS disabled.
      (function () {
        document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
