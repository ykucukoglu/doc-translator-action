<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Switch to light theme"
  aria-pressed="true"
>
  <svg class="icon icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="3.5" stroke="currentColor" stroke-width="1.3" />
    <path
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      d="M8 1v1.5M8 13.5V15M15 8h-1.5M2.5 8H1M12.7 3.3l-1 1M4.3 11.7l-1 1M12.7 12.7l-1-1M4.3 4.3l-1-1"
    />
  </svg>
  <svg class="icon icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linejoin="round"
      d="M13.5 9.5a5.5 5.5 0 0 1-7-7 5.5 5.5 0 1 0 7 7Z"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px, not a tighter fit around the 16px icon - the WCAG/Apple/Material touch-target
       minimum for a tap target, not just a visual size choice. */
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    cursor: pointer;
    position: relative;
  }

  .theme-toggle:hover {
    background: var(--color-bg-raised);
  }

  .icon {
    position: absolute;
  }

  /* Text-content-free state switch (icon visibility), never a layout-affecting DOM swap. */
  :global([data-theme='light']) .icon-moon,
  :global([data-theme='dark']) .icon-sun {
    display: none;
  }
</style>

<script>
  const button = document.getElementById('theme-toggle') as HTMLButtonElement;

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function applyLabel() {
    const theme = currentTheme();
    button.setAttribute('aria-pressed', String(theme === 'dark'));
    button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  }

  applyLabel();

  button.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    applyLabel();
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
  });
</script>
