---
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

// Only two locales exist today (en, tr) and only two pages have a real translated counterpart
// (getting-started, glossary - the two files website-dogfooding.yml actually translates). Every
// other page (the homepage, /architecture, /configuration) is hand-authored .astro, not a docs
// collection entry, so it has no translated counterpart and never will without a much bigger
// restructuring - see the conversation this was scoped from. Rather than hide the switcher on
// those pages (tried and rejected: a visitor landing on the English homepage would have zero
// indication Turkish content exists anywhere on the site), it stays visible everywhere and falls
// back to the other locale's getting-started page - a real, working destination, not a dead end.
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const relativePath = currentPath.startsWith(base) ? currentPath.slice(base.length) : currentPath;
const trimmed = relativePath.replace(/^\/+|\/+$/g, '');

const isTr = trimmed === 'tr' || trimmed.startsWith('tr/');
const currentLocale = isTr ? 'tr' : 'en';
const otherLocale = isTr ? 'en' : 'tr';
const slugWithoutLocale = isTr ? trimmed.replace(/^tr\/?/, '') : trimmed;

const entries = slugWithoutLocale ? await getCollection('docs') : [];
const hasCounterpart = slugWithoutLocale ? entries.some((e) => e.id === `${otherLocale}/${slugWithoutLocale}`) : false;

const targetHref = hasCounterpart
  ? withBase(otherLocale === 'en' ? slugWithoutLocale : `${otherLocale}/${slugWithoutLocale}`)
  : withBase(otherLocale === 'en' ? '/' : `${otherLocale}/getting-started`);

const label = otherLocale === 'tr' ? 'Türkçe' : 'English';
---

<a href={targetHref} class="language-switcher" aria-label={`Switch to ${label}`}>
  {otherLocale.toUpperCase()}
</a>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Same 44px touch-target height as ThemeToggle, so the two sit flush together in the
       header - a visual mismatch here would read as an afterthought bolted on, not a real
       feature. */
    height: 2.75rem;
    padding-inline: var(--space-3);
    background: transparent;
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .language-switcher:hover {
    background: var(--color-bg-raised);
  }
</style>
